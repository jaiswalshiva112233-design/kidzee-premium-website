rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.centreAdmin == true;
    }

    function isOwner() {
      return isAdmin() && request.auth.token.centreRole == 'OWNER';
    }

    // Public forms use validated Next.js server routes. Server IAM bypasses
    // these client rules; browsers cannot enumerate or write private data.
    match /{document=**} {
      allow read, write: if false;
    }

    match /publicWebsite/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminSummaries/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /careerApplications/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /mediaProcessingJobs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiRecommendations/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiRevisionHistory/{document=**} {
      allow read: if isOwner();
      allow write: if false;
    }
  }
}
