model AdminUser {
  invoicesCreated    FeeInvoice[] @relation("InvoiceCreatedBy")
  id                 String       @id @default(cuid())
  name               String
  email              String?      @unique
  role               AdminRole
  active             Boolean      @default(true)
  passwordHash       String?
  sessionVersion     Int          @default(1)
  failedAttempts     Int          @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  mustChangePassword Boolean      @default(false)
  permissions        Json?
  lastLoginAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  activities                    ActivityLog[]
  enquiriesCreated              Enquiry[]                  @relation("EnquiryCreatedBy")
  followUpsCreated              FollowUp[]                 @relation("FollowUpCreatedBy")
  paymentsCreated               FeePayment[]               @relation("PaymentCreatedBy")
  expensesCreated               Expense[]                  @relation("ExpenseCreatedBy")
  attendanceMarked              StudentAttendance[]        @relation("StudentAttendanceMarkedBy")
  staffAttendanceMarked         StaffAttendance[]          @relation("StaffAttendanceMarkedBy")
  extraDutiesCreated            StaffExtraDuty[]           @relation("StaffExtraDutyCreatedBy")
  extraDutiesApproved           StaffExtraDuty[]           @relation("StaffExtraDutyApprovedBy")
  staffLeavesCreated            StaffLeaveRequest[]        @relation("StaffLeaveCreatedBy")
  staffLeavesApproved           StaffLeaveRequest[]        @relation("StaffLeaveApprovedBy")
  staffPayrollsGenerated        StaffPayroll[]             @relation("StaffPayrollGeneratedBy")
  staffPayrollsApproved         StaffPayroll[]             @relation("StaffPayrollApprovedBy")
  staffPayrollsPaid             StaffPayroll[]             @relation("StaffPayrollPaidBy")
  documentsUploaded             StudentDocument[]          @relation("StudentDocumentUploadedBy")
  documentsVerified             StudentDocument[]          @relation("StudentDocumentVerifiedBy")
  daycareSessionsCreated        DaycareSession[]           @relation("DaycareSessionCreatedBy")
  daycareSessionsApproved       DaycareSession[]           @relation("DaycareSessionApprovedBy")
  studentChargesCreated         StudentCharge[]            @relation("StudentChargeCreatedBy")
  studentChargesApproved        StudentCharge[]            @relation("StudentChargeApprovedBy")
  calendarDocumentsUploaded     AcademicCalendarDocument[] @relation("CalendarDocumentUploadedBy")
  calendarEventsCreated         AcademicCalendarEvent[]    @relation("CalendarEventCreatedBy")
  leadActivitiesRecorded        LeadActivity[]             @relation("LeadActivityRecordedBy")
  leadAppointmentsRecorded      LeadAppointment[]          @relation("LeadAppointmentRecordedBy")
  followUpsCompleted            FollowUp[]                 @relation("FollowUpCompletedBy")
  growthRecommendationsMade     GrowthRecommendation[]     @relation("GrowthRecommendationCreatedBy")
  growthRecommendationsReviewed GrowthRecommendation[]     @relation("GrowthRecommendationReviewedBy")
  campaignUrlsCreated           CampaignUrl[]              @relation("CampaignUrlCreatedBy")
  notifications                 AdminNotification[]        @relation("NotificationRecipient")
  pushDevices                   PushDevice[]
  notificationPreference        NotificationPreference?

  @@index([role])
  @@index([active])
}

model AdminCredential {
  id                String    @id @default("primary")
  passwordHash      String
  sessionVersion    Int       @default(1)
  failedAttempts    Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Enquiry {
  id                       String        @id @default(cuid())
  enquiryNumber            String        @unique
  parentName               String
  childName                String?
  childDateOfBirth         DateTime?
  childAgeText             String?
  phone                    String
  alternatePhone           String?
  email                    String?
  programme                Programme?
  source                   EnquirySource
  status                   EnquiryStatus @default(NEW)
  message                  String?
  notes                    String?
  preferredVisitDate       DateTime?
  trialDate                DateTime?
  nextFollowUpAt           DateTime?
  admittedAt               DateTime?
  formSubmissionId         String?       @unique
  lastWebsiteSubmissionAt  DateTime?
  websiteSubmissionCount   Int           @default(0)
  latestPageUrl            String?
  latestLandingPage        String?
  latestReferrer           String?
  latestUtmSource          String?
  latestUtmMedium          String?
  latestUtmCampaign        String?
  latestUtmContent         String?
  latestUtmTerm            String?
  latestGclid              String?
  latestGbraid             String?
  latestWbraid             String?
  latestFbclid             String?
  latestTrafficChannel     String?
  latestTrafficClass       String?
  firstTouchAttribution    Json?
  lastTouchAttribution     Json?
  googleAdmissionSentAt    DateTime?
  googleAdmissionAttemptAt DateTime?
  googleAdmissionAttempts  Int           @default(0)
  googleAdmissionError     String?
  metaAdmissionSentAt      DateTime?
  metaAdmissionAttemptAt   DateTime?
  metaAdmissionAttempts    Int           @default(0)
  metaAdmissionError       String?
  stageChangedAt           DateTime      @default(now())
  qualifiedAt              DateTime?
  closedAt                 DateTime?
  lostReason               String?
  familyId                 String?
  createdById              String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  createdBy          AdminUser?                  @relation("EnquiryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  followUps          FollowUp[]
  websiteSubmissions WebsiteLeadSubmission[]
  admission          Admission?
  enrollmentContract StudentEnrollmentContract?
  marketingJobs      MarketingConversionJob[]
  family             LeadFamily?                 @relation(fields: [familyId], references: [id], onDelete: SetNull)
  activities         LeadActivity[]
  appointments       LeadAppointment[]
  whatsappMessages   WhatsAppAutomationMessage[]

  @@index([phone])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([lastWebsiteSubmissionAt])
  @@index([nextFollowUpAt])
  @@index([familyId])
  @@index([stageChangedAt])
}

model LeadFamily {
  id           String   @id @default(cuid())
  familyName   String
  primaryPhone String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enquiries Enquiry[]

  @@index([primaryPhone])
}

model LeadActivity {
  id           String           @id @default(cuid())
  enquiryId    String
  type         LeadActivityType
  fromStatus   EnquiryStatus?
  toStatus     EnquiryStatus?
  title        String
  notes        String?
  metadata     Json?
  recordedById String?
  occurredAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())

  enquiry    Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  recordedBy AdminUser? @relation("LeadActivityRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([enquiryId, occurredAt])
  @@index([type, occurredAt])
  @@index([recordedById])
}

model LeadAppointment {
  id             String                @id @default(cuid())
  enquiryId      String
  kind           LeadAppointmentKind
  status         LeadAppointmentStatus @default(SCHEDULED)
  scheduledAt    DateTime
  completedAt    DateTime?
  outcome        String?
  parentFeedback String?
  notes          String?
  recordedById   String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  enquiry    Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  recordedBy AdminUser? @relation("LeadAppointmentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([enquiryId, scheduledAt])
  @@index([kind, status, scheduledAt])
  @@index([recordedById])
}

model WebsiteLeadSubmission {
  id                 String        @id @default(cuid())
  submissionId       String        @unique
  enquiryId          String
  source             EnquirySource
  enquiryType        String
  leadType           String        @default("admission")
  pageUrl            String?
  landingPage        String?
  referrer           String?
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  gclid              String?
  gbraid             String?
  wbraid             String?
  fbclid             String?
  trafficChannel     String?
  trafficClass       String        @default("GENUINE")
  isInternal         Boolean       @default(false)
  isTest             Boolean       @default(false)
  isBot              Boolean       @default(false)
  marketingConsent   Boolean       @default(false)
  fbc                String?
  fbp                String?
  firstTouch         Json?
  lastTouch          Json?
  landingPageId      String?
  landingVariantId   String?
  growthExperimentId String?
  receivedAt         DateTime      @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, receivedAt])
  @@index([source, receivedAt])
  @@index([leadType, trafficClass, receivedAt])
  @@index([trafficClass, receivedAt])
  @@index([landingPageId, landingVariantId, receivedAt])
  @@index([growthExperimentId, receivedAt])
  @@index([receivedAt])
}

model CareerApplication {
  id                  String                  @id @default(cuid())
  applicationNumber   String                  @unique
  name                String
  phone               String
  email               String?
  location            String?
  position            String
  leadType            String                  @default("recruitment")
  qualification       String?
  experience          String?
  currentRole         String?
  expectedSalary      String?
  joiningAvailability String?
  message             String?
  consent             Boolean                 @default(false)
  status              CareerApplicationStatus @default(NEW)
  resumeFileName      String?
  resumeMimeType      String?
  resumeSize          Int?
  resumeStoragePath   String?
  resumeData          Bytes?                  @db.ByteA
  trafficClass        String                  @default("GENUINE")
  source              String?
  medium              String?
  campaign            String?
  content             String?
  term                String?
  referrer            String?
  landingPage         String?
  gclid               String?
  gbraid              String?
  wbraid              String?
  fbclid              String?
  fbc                 String?
  fbp                 String?
  firstTouch          Json?
  lastTouch           Json?
  notes               String?
  reviewedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([status, createdAt])
  @@index([leadType, trafficClass, createdAt])
  @@index([source, campaign, createdAt])
  @@index([phone])
  @@index([createdAt])
}

model AiSeoRevision {
  id           String    @id @default(cuid())
  pageKey      String
  status       String    @default("APPLIED")
  currentData  Json
  proposedData Json
  evidence     Json?
  createdById  String?
  appliedAt    DateTime  @default(now())
  undoneAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([pageKey, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model FollowUp {
  id            String         @id @default(cuid())
  enquiryId     String
  title         String
  notes         String?
  dueAt         DateTime
  completedAt   DateTime?
  status        FollowUpStatus @default(PENDING)
  createdById   String?
  completedById String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  enquiry     Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  createdBy   AdminUser? @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy AdminUser? @relation("FollowUpCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([enquiryId])
  @@index([status, dueAt])
  @@index([completedById])
}

model Admission {
  id                String          @id @default(cuid())
  admissionNumber   String          @unique
  enquiryId         String?         @unique
  studentId         String?         @unique
  status            AdmissionStatus @default(DRAFT)
  programme         Programme
  admissionDate     DateTime?
  joiningDate       DateTime?
  documentsComplete Boolean         @default(false)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  enquiry            Enquiry?                   @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  student            Student?                   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  enrollmentContract StudentEnrollmentContract?

  @@index([status])
  @@index([joiningDate])
}

model Student {
  feeInvoices             FeeInvoice[]
  id                      String        @id @default(cuid())
  studentNumber           String        @unique
  firstName               String
  middleName              String?
  lastName                String?
  preferredName           String?
  dateOfBirth             DateTime
  gender                  String?
  programme               Programme
  programmeDefinitionId   String?
  status                  StudentStatus @default(ACTIVE)
  joiningDate             DateTime
  leavingDate             DateTime?
  bloodGroup              String?
  medicalNotes            String?
  allergies               String?
  addressLine1            String?
  addressLine2            String?
  locality                String?
  city                    String?
  state                   String?
  postalCode              String?
  profilePhotoUrl         String?
  identityFingerprint     String?
  duplicateOfStudentId    String?
  duplicateOverrideReason String?
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  admission            Admission?
  guardians            Guardian[]
  feeAccounts          StudentFeeAccount[]
  payments             FeePayment[]
  receipts             Receipt[]
  attendanceRecords    StudentAttendance[]
  documents            StudentDocument[]
  daycarePlans         StudentDaycarePlan[]
  daycareSessions      DaycareSession[]
  ledgerCharges        StudentCharge[]
  enrollmentContract   StudentEnrollmentContract?
  financialCorrections FinancialCorrection[]
  programmeDefinition  ProgrammeDefinition?        @relation(fields: [programmeDefinitionId], references: [id], onDelete: SetNull)
  whatsappMessages     WhatsAppAutomationMessage[]

  @@index([programme])
  @@index([programmeDefinitionId])
  @@index([status])
  @@index([dateOfBirth])
  @@index([joiningDate])
  @@index([identityFingerprint])
  @@index([duplicateOfStudentId])
}

model StudentEnrollmentContract {
  id                   String                   @id @default(cuid())
  contractNumber       String                   @unique
  studentId            String                   @unique
  admissionId          String?                  @unique
  enquiryId            String?                  @unique
  academicSession      String
  status               EnrollmentContractStatus @default(DRAFT)
  startDate            DateTime
  endDate              DateTime?
  preschoolEnabled     Boolean                  @default(false)
  preschoolProgrammeId String?
  preschoolClass       String?
  daycareEnabled       Boolean                  @default(false)
  mealsEnabled         Boolean                  @default(false)
  annualKitEnabled     Boolean                  @default(false)
  annualKitSkipReason  String?
  billingDay           Int                      @default(1)
  dueDay               Int                      @default(5)
  source               String                   @default("DIRECT")
  createdById          String?
  updatedById          String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  student              Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  admission            Admission?            @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  enquiry              Enquiry?              @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  preschoolProgramme   ProgrammeDefinition?  @relation(fields: [preschoolProgrammeId], references: [id], onDelete: SetNull)
  services             ContractService[]
  daycarePlans         StudentDaycarePlan[]
  ledgerCharges        StudentCharge[]
  invoices             FeeInvoice[]
  financialCorrections FinancialCorrection[]

  @@index([status, startDate, endDate])
  @@index([preschoolEnabled, preschoolClass, status])
  @@index([daycareEnabled, status])
  @@index([mealsEnabled, status])
  @@index([preschoolProgrammeId])
  @@index([academicSession])
}

model ContractService {
  id                String                   @id @default(cuid())
  contractId        String
  serviceType       ContractServiceType
  category          FeeCategory
  catalogueItemType String?
  catalogueItemId   String?
  label             String
  detail            String?
  quantity          Decimal                  @default(1) @db.Decimal(8, 2)
  amountSnapshot    Decimal                  @db.Decimal(12, 2)
  discountSnapshot  Decimal                  @default(0) @db.Decimal(12, 2)
  gstApplicable     Boolean                  @default(false)
  gstRate           Decimal?                 @db.Decimal(5, 2)
  gstInclusive      Boolean                  @default(true)
  taxableValue      Decimal                  @db.Decimal(12, 2)
  cgst              Decimal                  @default(0) @db.Decimal(12, 2)
  sgst              Decimal                  @default(0) @db.Decimal(12, 2)
  total             Decimal                  @db.Decimal(12, 2)
  recurring         Boolean                  @default(false)
  frequency         ContractServiceFrequency @default(ONE_TIME)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            ContractServiceStatus    @default(ACTIVE)
  sourceVersionId   String?
  skipReason        String?
  metadata          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  contract      StudentEnrollmentContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  daycarePlan   StudentDaycarePlan?
  invoiceItems  FeeInvoiceItem[]
  ledgerCharges StudentCharge[]

  @@index([contractId, status, effectiveFrom, effectiveTo])
  @@index([serviceType, status])
  @@index([catalogueItemType, catalogueItemId])
  @@index([sourceVersionId])
  @@index([frequency, recurring, status])
}

model StudentDocument {
  id              String                @id @default(cuid())
  studentId       String
  documentType    StudentDocumentType
  title           String
  fileName        String
  mimeType        String
