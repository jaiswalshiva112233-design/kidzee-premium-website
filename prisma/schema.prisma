  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastError       String?
  durationMs      Int?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, updatedAt])
  @@index([lastSucceededAt])
}
