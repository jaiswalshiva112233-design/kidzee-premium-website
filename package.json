{
  "name": "kidzee-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:firebase": "node scripts/validate-firebase-config.mjs",
    "validate:env": "node scripts/validate-production-env.mjs",
    "validate:migrations": "node scripts/validate-prisma-migrations.mjs",
    "test:migrations:fresh": "node scripts/test-fresh-migrations.mjs",
    "test:migrations:deploy": "node scripts/test-prisma-migrate-deploy.mjs",
    "test:build:production": "node scripts/test-production-build.mjs",
    "prepare:migrations": "node scripts/prepare-prisma-deploy.mjs",
    "deploy:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./setup-and-deploy.ps1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.8.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-sanity": "^13.2.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "sanity": "^6.8.0",
    "swiper": "^14.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
