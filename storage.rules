rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.centreAdmin == true;
    }

    match /public/gallery/derivatives/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 25 * 1024 * 1024;
    }

    match /public/gallery/media/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /private/students/{allPaths=**} {
      allow read, write: if false;
    }

    match /uploads/gallery/{allPaths=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.size < 800 * 1024 * 1024
        && request.resource.contentType.matches('^(image/(jpeg|png|webp|heic|heif)|video/(mp4|quicktime|webm|x-m4v))$');
      allow delete: if isAdmin();
    }

    match /private/careers/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
